# Ollama (autorização por IP, sem chave)
OLLAMA_BASE_URL=http://161.97.187.233:11434
OLLAMA_MODEL_FAST=gemma4:31b-cloud
OLLAMA_MODEL_MAIN=kimi-k2.6:cloud

# Sistema de chamados legado (simulado)
# Chance de cada chamada derrubar o serviço (0 a 1) e por quanto tempo ele fica fora
TICKET_SERVICE_FAILURE_RATE=0.1
TICKET_SERVICE_OUTAGE_MS=3000
TICKET_SERVICE_LATENCY_MIN_MS=80
TICKET_SERVICE_LATENCY_MAX_MS=400

# Sessão (cookie assinado). Em produção é obrigatório, com 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Cookie só via HTTPS. Padrão: true em produção. Use false se o deploy for HTTP puro.
SESSION_COOKIE_SECURE=

# Banco SQLite (conversas). Em Docker, aponte para um volume.
DATABASE_URL=file:./data/nexo.db

# Cria conversas de exemplo no console na primeira vez que o banco abre (false para desligar)
SEED_DEMO_CONVERSATIONS=true
